[Unit]
Description=VESPER PIANO relay (Claude API proxy for atelierfactory.jp/device/jukebox)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/vesper
EnvironmentFile=/etc/bb.env
Environment=VESPER_PORT=8768
# 凍結 (2026-09-14 緊急: API キーが間違っていた)。1 のあいだは Claude を呼ばず 503 を返す。鍵を直したらこの行を消して ./relay/deploy.sh
Environment=VESPER_FROZEN=1
Environment=VESPER_ORIGINS=https://atelierfactory.jp,https://www.atelierfactory.jp,https://atelierfactory.github.io
# 1 日の上限 (日本時間 0 時切替)。2026-09-13 さとるん決定: ピアノ 5 曲 / シンセ 5 曲 (アプリごとに数える)、同時に作曲してよい
Environment=VESPER_SONG_LIMIT=5
Environment=VESPER_TRACK_LIMIT=90
Environment=VESPER_OTHER_LIMIT=60
Environment=VESPER_IP_PER_MINUTE=30
Environment=VESPER_IP_PER_DAY=260
# 使えるモデルと出力の長さの上限 (Origin は偽れるので、金額はこちらで抑える)
Environment=VESPER_MODELS=claude-fable-5-1,claude-sonnet-5,claude-opus-5
Environment=MAX_TOKENS_CAP=110000
Environment=VESPER_STATE=/var/lib/vesper/counters.json
ExecStart=/usr/bin/node /opt/vesper/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
